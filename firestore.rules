rules_version = '2';

// BoloBill Firestore security rules (SRS §5.3 Sync Manager, build order
// step 7). Layout matches lib/data/remote/firestore_paths.dart: every shop's
// data lives under shops/{shopId}, with users/customers/bills/khataEntries/
// payments/receipts as subcollections (bills embed their line items — see
// db_schema.dart's note on why there is no separate billItems collection).
//
// Access model: a shop is owned by exactly one Firebase Auth uid, recorded
// as `owner_uid` on the shop document at creation (the SRS assumes one shop
// per device/install — no multi-staff real-time collaboration is being
// synced yet, only the owner's own device). Every read/write anywhere under
// a shop's subtree requires being signed in as that shop's owner.
//
// Deployed to the `bolo-bill` Firebase project's Firestore Rules editor
// (confirmed 2026-08-04) — keep this file and the Console copy in sync by
// hand for now (no CI step deploys it automatically); re-paste here after
// any Console-side edit, and vice versa after editing this file.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isShopOwner(shopId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.owner_uid == request.auth.uid;
    }

    match /shops/{shopId} {
      allow read, update: if isShopOwner(shopId);
      // The shop doc doesn't exist yet on first sync, so ownership can't be
      // checked via get() — instead the created doc must self-declare the
      // signed-in user as its owner.
      allow create: if isSignedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow delete: if false;

      match /{collection}/{docId} {
        allow read, write: if isShopOwner(shopId);
      }
    }
  }
}
